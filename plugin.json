{
  "name": "docvault",
  "version": "1.0.0",
  "description": "Document and expiry manager for cards, SSL certificates, IDs, documents, passwords, and private keys.",
  "author": "YourFinanceWORKS",
  "license_tier": "agpl",
  "api_routes": [
    {
      "path": "/api/v1/docvault",
      "methods": ["GET", "POST", "PUT", "DELETE"],
      "description": "Manage DocVault entries and MFA-gated sensitive details."
    }
  ],
  "database_tables": [
    "docvault_entries",
    "docvault_attachment_versions",
    "docvault_signatures",
    "docvault_mfa_enrollments",
    "docvault_share_tokens",
    "docvault_document_links",
    "docvault_attachment_locators"
  ],
  "features": [
    "expiry-tracking",
    "ai-card-scanning",
    "mfa-gated-vault",
    "document-tags",
    "password-private-key-management",
    "versioned-attachments",
    "digital-signatures",
    "retention-automation",
    "audit-packaging"
  ],
  "metadata": {
    "category": "security",
    "standalone": true
  }
}
